# Augmenter les timeouts et retries pour eviter les ECONNRESET en Docker
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=120000

# Limiter les connexions concurrentes (evite ECONNRESET)
maxsockets=3

# Verifier les sommes SHA512 (securite)
strict-peer-dependencies=false
package-lock=true
