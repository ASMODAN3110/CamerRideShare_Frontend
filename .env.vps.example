# À copier en .env dans /opt/apps/CamerRideShare/Frontend/ (même dossier que docker-compose.yml)

# URL publique de l'API (backend), sans « / » final. Intégrée au build : reconstruire après changement.
VITE_API_URL=https://api.camerrideshare.strife-cyber.org

# Nom de domaine du frontend (enregistrement DNS vers le VPS). À ajouter aussi à FRONTEND_URL côté API (CORS).
WEB_HOST=camerrideshare.strife-cyber.org
